# Application
PORT=3000
NODE_ENV=production

# Hosted MySQL: use either MYSQL_URL or the individual variables below.
# Never commit real credentials to source control.
MYSQL_URL=mysql://USERNAME:PASSWORD@HOST:3306/mediconnect
# MYSQL_HOST=your-db-host
# MYSQL_PORT=3306
# MYSQL_USER=your-db-user
# MYSQL_PASSWORD=your-db-password
# MYSQL_DATABASE=mediconnect
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_CONNECTION_LIMIT=10

# Initial administrator account. Set only during first deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# MediGuide provider integrations can be added server-side later.
# GEMINI_API_KEY=server-side-only
# GEMINI_MODEL=gemini-3.6-flash
